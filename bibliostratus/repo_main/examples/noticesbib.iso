72376-1bbr.d39,90 EUR  aFRb01300512 0a9782091723761  a20121127d2012    de y0frey50      ba0 afre  aFR  a||||j   00|y|  ar1 aPhysique, chimie, Term SbTexte impriméeenseignement spécifiqueeprogramme 2012fsous la direction de Valéry Prévost et Bernard Richouxg[par] Claire Ameline, Lionel Bernard, Claire Boggio... [et al.]  a[Paris]cNathandimpr. 2012eimpr. en Italie  a1 vol. (pagination multiple 593-[53] p.)cill. en noir et en coul., couv. ill. en coul.d25 cm| aSIRIUS  aLe livre contient une adresse Internet permettant l\'accès à un contenu complémentaire  aIndex 0039919817tSIRIUS (Paris. 2004)x1772-2241d2012  a5302Cadre de classement de la Bibliographie nationale française |315965623oISNI0000000057806778aPrévostbValéry4651 |314605053oISNI0000000000733512aRichouxbBernard4651 0aFRbFR-751131015c20121127gAFNORhFRBNF4279840600000012intermrc  5FR-751131009:42798406001001a2012-339934b759999999cTolbiac - Rez de Jardin - Sciences et technique - MagasindO  5FR-751131009:42798406002001a500 BAC Sb759999999cTolbiac - Haut de Jardin - Sciences et technique - Salle C - Libre accèsdN02494cam  2200337   450 FRBNF438439260000005http://catalogue.bnf.fr/ark:/12148/cb438439260  a978-2-01-203859-2bbr.d15,90 EUR  aFRb01442510 0a9782012038592  a20140618d2014    a  y0frey50      ba1 afreceng  aFR  a||||z   00|a|  ar1 aL\'été des secondes chancesbTexte impriméfMorgan Matsongtraduit de l\'anglais (États-Unis) par Alice Delarbre  aPariscHachettedDL 2014eimpr. en Espagne  a1 vol. (413 p.)ccouv. ill. en coul.d22 cm| aBloom  a1RLPEx0398-8384c280  cAviC4aLe dernier été de Robin, père de trois enfants, atteint d\'un cancer implacable. C\'est Taylor, la cadette, qui raconte. Toutes sortes d\'amours (filial, fraternel, sentimental...), le deuil, les adieux. Ces multiples motifs s\'entrelacent au cours de cet été suspendu. C\'est un roman respectueux et sensible, écrit avec soin. Avec, au final, une belle preuve d\'amour du père à ses enfants qu\'il ne verra pas grandir. Et on pleure plus d\'une fois, bien sûr. d20141201fMLAL2CNLJkAvis critique donné par le Centre national de la littérature pour la jeunesse  aTaylor a pris la fâcheuse habitude de fuir ses problèmes personnels. Mais lorsque son père, atteint d\'un cancer, choisit de passer son dernier été dans leur maison de vacances, elle ne se dérobe pas. C\'est dans ce village que, cinq ans plus tôt, elle avait laissé son premier amour et sa meilleure amie, avec la ferme décision de ne jamais les revoir...2Electre  aJAg15992CNLJkAvis critique donné par le Centre national de la littérature pour la jeunesse 0042609215tBloom (Paris. 2012)x2258-2762d2014 1tSecond chance summer  a8092Cadre de classement de la Bibliographie nationale française |316777768oISNI0000000418487558aMatsonbMorgan4070 |314424326oISNI0000000118841631aDelarbrebAlice4730 0aFRbFR-751131015c20140618gAFNORhFRBNF4384392600000052intermrc  5FR-751131010:43843926001001a2014-133879b759999999cTolbiac - Rez de Jardin - Littérature et art - MagasindO  5FR-751131010:43843926002001a- Littérature et art - Salle I - Actualité de l\'éditionb759999999cTolbiac - Haut de Jardin - Littérature et art - Libre accèsdN02692cam  2200349   450 FRBNF450364160000003http://catalogue.bnf.fr/ark:/12148/cb45036416q  a978-2-7144-6040-0bbr.d17 EUR  aFRb01633606 0a9782714460400  a20160511d2016    m  y0frey50      ba1 afrecdut  aFR  a||||z   00|a|  ar 0601ai bxxxe    602ctxt2rdacontent 0601an  602cn2rdamedia1 aUne heure avant minuitbTexte impriméfIda Simonsgtraduit du néerlandais par Mireille Cohendy  aPariscBelfonddDL 2016eimpr. en Allemagne  a1 vol. (220 p.)d21 cm| aVintagev20  aÀ Anvers, Amsterdam et Berlin, au début des années 1930 Les parents de Gittel, douze ans, se disputent souvent, de préférence les jours de fête. Toute la famille vit à La Haye mais quand les murs tremblent, la mère de Gittel prend sa fille sous le bras et rentre chez sa mère à Anvers. Ce qui embête bien la petite car elle doit ensuite rattraper son retard à l\'école et ses leçons de piano. Et que ces allers-retours constants l\'éloignent aussi de sa meilleure amie Milli. Pourtant, Gittel aime aussi revoir sa ville natale, la maison de sa grand-mère et la vieille bonne, la fidèle Rosalba. Et puis, elle se fait de nouveaux amis, dont Lucie, une célibataire de 29 ans qui l\'invite à venir jouer du piano sur le beau Steinway de son père, et Gabriel, un beau garçon qui travaille pour le père de Lucie. Mais à peine le temps de savourer cette nouvelle vie que son schlemiel de père voit ses affaires à nouveau péricliter. Et toute la famille de partir pour Berlin, de perdre encore une fortune, de rentrer à La Haye, puis à Anvers, suite à une énième dispute. En une année, Gittel va grandir d\'un coup, gagnant en maturité, perdant en insouciance. Et pendant ce temps, l\'Allemagne se prépare à annexer les Flandres...2éditeur 0042805551t[Vintage] (Paris. 2012)x2263-8555v20 1tEen dwaze Maagd  a8032Cadre de classement de la Bibliographie nationale française |317000709oISNI0000000390078970aSimonsbIdaf1911-19604070 |313178913oISNI0000000001947993aCohendybMireillef1953-....4730 0aFRbFR-751131015c20160511gAFNORhFRBNF4503641600000032intermrc  5FR-751131010:45036416001001a2016-119328b759999999cTolbiac - Rez de Jardin - Littérature et art - MagasindO  5FR-751131010:45036416002001a2017-171746b759999999cTolbiac - Haut de Jardin - Littérature et art - MagasindN01409cam  2200313   450 001002100000003004700021010003800068020001700106073001800123100004100141101000800182102000700190105001800197106000600215200007200221205001800293210006900311215003900380225002600419300002600445410006100471606005900532676001900591686007000610700007600680801007000756930012300826930014600949FRBNF425968980000000http://catalogue.bnf.fr/ark:/